{
  "name": "lab-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "Static Lab Atlas frontend formatting tools",
  "scripts": {
    "format": "prettier --write \"index.html\" \"retrieval.html\" \"workflow*.html\" \"keyword-missing.html\" \"outputs/paper-atlas/**/*.{js,css,html}\" \"scripts/**/*.{js,cjs}\"",
    "format:check": "prettier --check \"index.html\" \"retrieval.html\" \"workflow*.html\" \"keyword-missing.html\" \"outputs/paper-atlas/**/*.{js,css,html}\" \"scripts/**/*.{js,cjs}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
