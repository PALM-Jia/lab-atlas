{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paper_id",
    "annotations",
    "abstentions",
    "input_issues"
  ],
  "properties": {
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyword_id",
          "exact_quote",
          "evidence_field",
          "reason_zh"
        ],
        "properties": {
          "keyword_id": {
            "type": "string",
            "enum": [
              "deep-clustering",
              "ensemble-clustering",
              "subspace-clustering",
              "multi-label-learning",
              "label-distribution-learning",
              "label-enhancement",
              "dimensionality-reduction",
              "image-segmentation",
              "data-imputation-recovery",
              "hallucination-mitigation",
              "model-merging",
              "multimodal-retrieval",
              "value-preference-alignment",
              "adversarial-robustness",
              "dataset-distillation",
              "person-reidentification",
              "multi-objective-optimization",
              "confidence-calibration",
              "low-rank-modeling",
              "nonnegative-matrix-factorization",
              "graph-structure-learning",
              "graph-manifold-regularization",
              "graph-neural-networks",
              "contrastive-learning",
              "pseudo-label-self-training",
              "sparse-representation",
              "bayesian-inference",
              "label-correlation-modeling",
              "parameter-efficient-fine-tuning",
              "latent-reasoning",
              "knowledge-distillation",
              "domain-adaptation",
              "pairwise-constraint-propagation",
              "classifier-ensemble",
              "partial-label-learning",
              "semi-supervised-learning",
              "class-imbalance",
              "noisy-label-learning",
              "multi-view-learning",
              "federated-learning",
              "zero-shot-learning",
              "open-vocabulary-recognition",
              "hyperspectral-images",
              "traffic-data",
              "underwater-images",
              "large-language-models",
              "vision-language-models",
              "weakly-supervised-learning",
              "large-vision-language-models"
            ]
          },
          "exact_quote": {
            "type": "string",
            "minLength": 1
          },
          "evidence_field": {
            "enum": [
              "title",
              "abstract"
            ]
          },
          "reason_zh": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "abstentions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyword_id",
          "reason_zh"
        ],
        "properties": {
          "keyword_id": {
            "type": "string",
            "enum": [
              "deep-clustering",
              "ensemble-clustering",
              "subspace-clustering",
              "multi-label-learning",
              "label-distribution-learning",
              "label-enhancement",
              "dimensionality-reduction",
              "image-segmentation",
              "data-imputation-recovery",
              "hallucination-mitigation",
              "model-merging",
              "multimodal-retrieval",
              "value-preference-alignment",
              "adversarial-robustness",
              "dataset-distillation",
              "person-reidentification",
              "multi-objective-optimization",
              "confidence-calibration",
              "low-rank-modeling",
              "nonnegative-matrix-factorization",
              "graph-structure-learning",
              "graph-manifold-regularization",
              "graph-neural-networks",
              "contrastive-learning",
              "pseudo-label-self-training",
              "sparse-representation",
              "bayesian-inference",
              "label-correlation-modeling",
              "parameter-efficient-fine-tuning",
              "latent-reasoning",
              "knowledge-distillation",
              "domain-adaptation",
              "pairwise-constraint-propagation",
              "classifier-ensemble",
              "partial-label-learning",
              "semi-supervised-learning",
              "class-imbalance",
              "noisy-label-learning",
              "multi-view-learning",
              "federated-learning",
              "zero-shot-learning",
              "open-vocabulary-recognition",
              "hyperspectral-images",
              "traffic-data",
              "underwater-images",
              "large-language-models",
              "vision-language-models",
              "weakly-supervised-learning",
              "large-vision-language-models"
            ]
          },
          "reason_zh": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "paper_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "input_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
